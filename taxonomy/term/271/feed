      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;150 MW &lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Electrolyzer&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li&gt;Export-scale production facility for renewable and low-carbon hydrogen and ammonia&lt;/li&gt;&lt;li&gt;Mix of green and blue hydrogen&lt;/li&gt;&lt;li&gt;Carbon capture&lt;/li&gt;&lt;li&gt;Licensor and OEM screening and selection&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Scope includes concept study and pre-FEED services for a greenfield export-scale production facility for renewable and low-carbon hydrogen and ammonia. Hydrogen will be produced using electrolysis technology (green) and natural gas reforming with carbon capture (blue). Facility includes utilities and offsites, ammonia storage, pipeline and marine loading.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Low Carbon Hydrogen &amp;amp; Ammonia&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2024-10/H2%20Perth.png.webp?itok=dHgW-I2d" width="864" height="576" alt="H2 Perth " class="image-style-webp"&gt;


