<item>
  <title>Ammonia Terminal &amp; Cracking Facilities</title>
  <link>https://www.dodsalgroup.com/projects/ammonia-terminal-cracking-facilities</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/ammonia-terminal-cracking-facilities" hreflang="en"&gt;Ammonia Terminal &amp;amp; Cracking Facilities&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;40 - 70 kT&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p dir="ltr"&gt;Ammonia Storage&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;70 - 150 kTA H2&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Ammonia Cracking Train production&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li&gt;Ammonia-to-hydrogen cracking technology evaluation and selection&lt;/li&gt;&lt;li&gt;Design according the new PGS 12 guidelines for ammonia terminals&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Scope includes multiple concept and feasibility studies for ammonia terminal and cracking. The terminal includes full containment ammonia storage tanks, boil-off gas system, aqueous ammonia injection facilities, inert vent scrubbing, in-tank pumps for ammonia transfer, export heating, metering, loading arms for import and export, train loading and ammonia drain systems. Ammonia cracking is performed in a single or multiple trains. This is followed by product purification and H2 product compression to pipeline pressure. The project includes utilities, off-sites and infrastructure.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Low Carbon Hydrogen &amp;amp; Ammonia&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2026-01/Ammonia%20Terminal%20%26%20Cracking%20Facilities.png.webp?itok=rKYdbmH0" width="864" height="576" alt="Ammonia Terminal &amp;amp; Cracking Facilities" class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;Multiple in Western Europe&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;Concept &amp;amp; Feasibility Study&lt;/div&gt;
          &lt;/div&gt;
</description>
