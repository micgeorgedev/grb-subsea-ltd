  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/peru-lng" hreflang="en"&gt;Peru LNG&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;5,600 workers&lt;/div&gt;
      
