<item>
  <title>Woodfibre LNG</title>
  <link>https://www.dodsalgroup.com/projects/woodfibre-lng</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/woodfibre-lng" hreflang="en"&gt;Woodfibre LNG&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;250,000&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;m3 floating LNG storage capacity&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;100%&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;renewable hydroelectric technology&amp;nbsp;&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li dir="ltr"&gt;Fully modularized LNG facility&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;E-drive application&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;World’s lowest-emission LNG facility&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;This project incorporates cutting-edge technologies, including Honeywell LNG's C3MR liquefaction technology, with electric drive compressors using imported renewable hydroelectric power to facilitate the production and export of LNG. The facility consists of a single liquefaction train, with a capacity of 2.1 million metric tons per annum. In addition, a gas pre-treatment facility is integrated into the project. Two floating storage tanks with a capacity of 130,000 m3 each along with a dedicated loading berth are also included. The facility has been designed to be fully modularized, enhancing efficiency and reducing onsite construction risks.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Liquefaction&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2026-01/Woodfibre%20LNG%20Project%20%281%29.png.webp?itok=DRU-WCql" width="864" height="576" alt="Woodfibre LNG" class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;Canada&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;FEED &amp;amp; EPFC&lt;/div&gt;
          &lt;/div&gt;
</description>
