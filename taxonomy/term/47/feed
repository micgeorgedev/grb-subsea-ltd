<item>
  <title>Kasawari Carbon Capture &amp; Storage</title>
  <link>https://www.dodsalgroup.com/projects/kasawari-carbon-capture-storage</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/kasawari-carbon-capture-storage" hreflang="en"&gt;Kasawari Carbon Capture &amp;amp; Storage&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;85&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;&amp;nbsp;miles pipeline section&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;15,000 MT CCS&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;platform jacket&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li dir="ltr"&gt;Set to become one of the largest CCS projects in the world&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;Expected to reduce carbon dioxide volume emitted via flaring by 3.3 MT CO2e per annum&amp;nbsp;&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;Dodsal Group’s first CCS project in Asia&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Dodsal Group is performing the transportation and structural installation of a 138-kilometer (85 miles) pipeline section, a 15,000 metric tonne (MT) CCS platform jacket, and a bridge connecting to the existing central processing platform in the Kasawari gas development field.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Subsea Field Development&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2024-11/Kasawari%20Spotlight%20%281%29.jpg.webp?itok=f3-caF58" width="864" height="576" alt="Kasawari Carbon Capture" class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;Block SK 316, Malaysia&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;Transportation &amp;amp; Installation&lt;/div&gt;
          &lt;/div&gt;
</description>
