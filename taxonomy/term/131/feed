<item>
  <title>Marjan Increment Project – Package 4 Offshore Gas Facilities</title>
  <link>https://www.dodsalgroup.com/projects/marjan-increment-project-package-4-offshore-gas-facilities-0</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/marjan-increment-project-package-4-offshore-gas-facilities-0" hreflang="en"&gt;Marjan Increment Project – Package 4 Offshore Gas Facilities&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;3&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;gas tie-in platforms&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;4&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;gas wellhead platforms&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;Over 300&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;miles of pipelines&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;62&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;miles of subsea cables&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;p&gt;Over 20 million work hours have taken place since the start of the project&lt;/p&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Dodsal Group was selected for the Marjan Package 4 project in 2019, representing the second largest EPCI offshore contract to be awarded from Saudi Aramco in the Marjan Increment development. The project has a large fabrication scope, including gas tie-in and gas wellhead platforms, with pipelines and subsea cables.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Pipelines, Cables &amp;amp; Umbilicals&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2024-10/Marjan%20Increment%20Project%204%20.png.webp?itok=TpyTM5CV" width="864" height="576" alt="Marjan Package 4 " class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;Offshore Saudi Arabia&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;EPCI&lt;/div&gt;
          &lt;/div&gt;
</description>
