<item>
  <title>VARO Alpha Hydrogenated Vegetable Oil (HVO) / Sustainable Aviation Fuel (SAF) Production Facility</title>
  <link>https://www.dodsalgroup.com/projects/varo-alpha-hydrogenated-vegetable-oil-hvo-sustainable-aviation-fuel-saf-production</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/varo-alpha-hydrogenated-vegetable-oil-hvo-sustainable-aviation-fuel-saf-production" hreflang="en"&gt;VARO Alpha Hydrogenated Vegetable Oil (HVO) / Sustainable Aviation Fuel (SAF) Production Facility&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;350 kTa&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Total production capacity&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;245 kt/a SAF&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;remainder a mixture of bio-naphtha and bio-LPG and Hydrotreated Vegetable Oil (HVO)&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;between&amp;nbsp;100% SAF and 100% HVO&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;Full flexibility&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li&gt;Provided Owner’s Engineering Services during the Basic Design and Engineering Package (BDEP) phase&amp;nbsp;&lt;/li&gt;&lt;li&gt;Maximum modularization and prefabrication construction approach&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;The facility utilizes&amp;nbsp;Tall Oil&amp;nbsp;Fatty&amp;nbsp;Acids (TOFA) and&amp;nbsp;Used&amp;nbsp;Cooking&amp;nbsp;Oil (UCO) as feedstocks to produce HVO/SAF, LPG and naphtha via pre-treatment, hydrodeoxygenation, isomerization, hydrocracking, and fractionation processes.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Sustainable Aviation Fuels (SAF)&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2026-01/VARO.jpg.webp?itok=gaU1Utbj" width="864" height="576" alt="VARO Alpha Hydrogenated Vegetable Oil" class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;The Netherlands&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;FEED&lt;/div&gt;
          &lt;/div&gt;
</description>
