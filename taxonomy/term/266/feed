<item>
  <title>GEVO Sustainable Aviation Fuel (SAF) Facilities </title>
  <link>https://www.dodsalgroup.com/projects/gevo-sustainable-aviation-fuel-saf-facilities</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/gevo-sustainable-aviation-fuel-saf-facilities" hreflang="en"&gt;GEVO Sustainable Aviation Fuel (SAF) Facilities &lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;Expected to produce&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p dir="ltr"&gt;up to 65 million gallons of SAF, diesel and renewable gasoline with a lifecycle net-zero GHG footprint&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;Generates 550 million&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p dir="ltr"&gt;pounds of high-value nutritional products annually&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li&gt;Engineering, execution planning and pricing for the EPC phase of GEVO’s Net-Zero 1 project&lt;/li&gt;&lt;li&gt;Powered by wind energy with thermal needs met by renewable natural gas&lt;/li&gt;&lt;li&gt;Includes green hydrogen and carbon capture components&lt;/li&gt;&lt;li&gt;Sustainable and environmentally friendly approach to fuel production&lt;/li&gt;&lt;li&gt;Renewable natural gas produced using manure from dairy cattle and livestock&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;The project involves engineering, execution planning and pricing for the EPC phase of Net-Zero 1. The modularized facility utilizes bioethanol as a feedstock to produce SAF via dehydration, oligomerization, hydrogenation and fractionation processes.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Sustainable Aviation Fuels (SAF)&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2024-10/GEVO%20Project.png.webp?itok=okCDN2h6" width="864" height="576" alt="GEVO Sustainable Aviation Fuel (SAF) Facilities " class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;United States&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;FEED&lt;/div&gt;
          &lt;/div&gt;
</description>
