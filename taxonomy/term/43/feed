<item>
  <title>Project Everest</title>
  <link>https://www.dodsalgroup.com/projects/project-everest-0</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;&lt;h2&gt;&lt;a href="https://www.dodsalgroup.com/projects/project-everest-0" hreflang="en"&gt;Project Everest&lt;/a&gt;&lt;/h2&gt;&lt;/span&gt;

      &lt;div class="field field--name-field-project-metrics field--type-entity-reference-revisions field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;30-50%&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;reduction of CO2 from steel-making site&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;div class="paragraph paragraph--type--metrics paragraph--view-mode--default"&gt;
          
            &lt;div class="field field--name-field-metric-title field--type-string field--label-hidden field__item"&gt;4-5 Mt CO2&lt;/div&gt;
      
            &lt;div class="clearfix text-formatted field field--name-field-metric-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;annual &lt;strong&gt;reduction target&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;
      
      &lt;/div&gt;
&lt;/div&gt;
          &lt;/div&gt;
  


  &lt;div class="clearfix text-formatted field field--name-field-highlights field--type-text-long field--label-above"&gt;
    &lt;div class="field__label"&gt;Highlights&lt;/div&gt;
              &lt;div class="field__item"&gt;&lt;ul&gt;&lt;li dir="ltr"&gt;Represents significant progress toward carbon-neutral steel production&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;Selection of CO2 separation technology&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;CO2 compressor driver study&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;Equipment selection&amp;nbsp;&lt;/li&gt;&lt;li dir="ltr"&gt;Sizing and plot space&lt;/li&gt;&lt;li dir="ltr"&gt;Completed in 2021&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;
          &lt;/div&gt;

            &lt;div class="clearfix text-formatted field field--name-field-project-description field--type-text-long field--label-hidden field__item"&gt;&lt;p&gt;This project focused on achieving substantial CO2 reduction and advancing sustainable practices in the steel-making industry. During the pre-FEED phase, a thorough evaluation and selection of CO2 separation technology and a detailed study of the CO2 compressor driver were conducted. Equipment selection, sizing and plot space planning were integral components of this project.&lt;/p&gt;&lt;/div&gt;
      
            &lt;div class="field field--name-field-solutions-category field--type-entity-reference field--label-hidden field__item"&gt;Regasification&lt;/div&gt;
      
            &lt;div class="field field--name-field-spotlight-image field--type-image field--label-hidden field__item"&gt;  &lt;img loading="eager" src="https://www.dodsalgroup.com/sites/default/files/styles/webp/public/2024-11/Project%20Everest%20Spotlight%20%281%29.jpg.webp?itok=cweGOvgC" width="864" height="576" alt="Project Everest" class="image-style-webp"&gt;


&lt;/div&gt;
      
  &lt;div class="field field--name-field-location field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
              &lt;div class="field__item"&gt;The Netherlands&lt;/div&gt;
          &lt;/div&gt;

  &lt;div class="field field--name-field-scope field--type-string field--label-above"&gt;
    &lt;div class="field__label"&gt;Scope&lt;/div&gt;
              &lt;div class="field__item"&gt;Study &amp;amp; Pre-FEED&lt;/div&gt;
          &lt;/div&gt;
</description>
